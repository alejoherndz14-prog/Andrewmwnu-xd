local function updateSilentAimTarget()
    local config = silentAimConfig
    if not config.Enabled then
        silentAimTargetPart, silentAimTargetPosition = nil, nil
        return
    end
    local cam = Workspace.CurrentCamera
    if not cam then
        silentAimTargetPart, silentAimTargetPosition = nil, nil
        return
