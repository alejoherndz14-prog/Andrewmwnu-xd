task.spawn(function()
    while task.wait(0.05) do
        if not espEnabled then espContenedor:ClearAllChildren() continue end
        for _,jug in pairs(Players:GetPlayers()) do
            if jug ~= player and esEnemigo(jug) and jug.Character and jug.Character:FindFirstChild("HumanoidRootPart") and jug.Character.Humanoid.Health > 0 then
                local hrp = jug.Character.HumanoidRootPart
                local posCam, visible = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0,2.5,0))
                local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
                local etiqueta = espContenedor:FindFirstChild("ESP_"..jug.UserId) or Instance.new("TextLabel")
                etiqueta.Name = "ESP_"..jug.UserId
                etiqueta.BackgroundTransparency = 1
                etiqueta.Font = Enum.Font.GothamBold
                etiqueta.TextSize = 12
                etiqueta.TextStrokeTransparency = 0
                etiqueta.TextColor3 = espColor
                etiqueta.Parent = espContenedor
                if visible then
                    etiqueta.Position = UDim2.new(0,posCam.X,0,posCam.Y-35)
                    etiqueta.Text = ""
                    if espOpt.Nombre then etiqueta.Text = jug.Name end
                    if espOpt.Vida then etiqueta.Text ..= "\nVida: "..math.floor(jug.Character.Humanoid.Health) end
                    if espOpt.Distancia then etiqueta.Text ..= "\nDist: "..dist.."m" end
                else etiqueta.Text = "" end
            else
                if espContenedor:FindFirstChild("ESP_"..jug.UserId) then espContenedor["ESP_"..jug.UserId]:Destroy() end
            end
        end
    end
end)

-- SISTEMA AIMBOT / SILENT AIM
task.spawn(function()
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    while task.wait() do
        if (aimbotEnabled or autoShootEnabled or silentAimEnabled or silentAimFov) and not estaEnLobby() then
            local pj = player.Character if not pj or not pj:FindFirstChild("HumanoidRootPart") then continue end
            local mejorObj, mejorDist = nil, math.huge
            for _,jug in pairs(Players:GetPlayers()) do
                if jug ~= player and esEnemigo(jug) and jug.Character and jug.Character:FindFirstChild("Humanoid") and jug.Character.Humanoid.Health>0 then
                    local partes = {}
                    if aimParte == "Cabeza" then partes = {"Head"}
                    elseif aimParte == "Torso" then partes = {"UpperTorso","HumanoidRootPart"}
                    else partes = {"Head","UpperTorso","LeftArm","RightArm","LeftLeg","RightLeg"} end
                    for _,nom in ipairs(partes) do
                        local parte = jug.Character:FindFirstChild(nom)
                        if parte then
                            local pos2d, vis = camera:WorldToViewportPoint(parte.Position)
                            local distCentro = (Vector2.new(pos2d.X,pos2d.Y) - Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)).Magnitude
                            local distFisica = (parte.Position - pj.HumanoidRootPart.Position).Magnitude
                            local pasa = false
                            if silentAimFov then pasa = vis and distCentro <= fovRadius end
                            if aimbotEnabled or silentAimEnabled then pasa = true end
                            if pasa and distFisica < mejorDist then
                                rayParams.FilterDescendantsInstances = {pj, jug.Character}
                                if not workspace:Raycast(pj.Head.Position, parte.Position - pj.Head.Position, rayParams) then
                                    mejorDist = distFisica
                                    mejorObj = parte
                                end
                            end
                        end
                    end
                end
            end
            getgenv().ObjetivoAim = mejorObj
        else getgenv().ObjetivoAim = nil end
    end
end)

-- DISPARO AUTOMÁTICO Y SILENT AIM
local meta = getmetatable(workspace).__index
getmetatable(workspace).__index = newcclosure(function(s, m)
    if getgenv().ObjetivoAim and s == workspace and (m == "Raycast" or m == "FindPartOnRay") then
        local orig = meta[s]
        return function(inst, ...)
            local a,b,c,d = ...
            if m == "Raycast" then return orig(inst,a,(getgenv().ObjetivoAim.Position - a).Unit*9999,c,d) end
            return orig(inst,Ray.new(a,(getgenv().ObjetivoAim.Position - a).Unit*9999),b,c,d)
        end
    end
    return meta[s]
end)

-- MOVIMIENTO Y HITBOX
RunService.Heartbeat:Connect(function()
    local pj = player.Character if not pj or not pj:FindFirstChild("Humanoid") then return end
    pj.Humanoid.WalkSpeed = velocidad
    pj.Humanoid.JumpPower = salto
    if vuela then
        local dir = camera.CFrame.LookVector
        local mov = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then mov += dir end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then mov -= dir end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then mov -= dir:Cross(Vector3.new(0,1,0)).Unit end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then mov += dir:Cross(Vector3.new(0,1,0)).Unit end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mov += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then mov += Vector3.new(0,-1,0) end
        pj.HumanoidRootPart.Velocity = mov.Magnitude>0 and mov.Unit*50 or Vector3.zero
    end
    if hitboxEnabled then
        for _,jug in pairs(Players:GetPlayers()) do
            if jug~=player and esEnemigo(jug) and jug.Character and jug.Character:FindFirstChild("HumanoidRootPart") then
                jug.Character.HumanoidRootPart.Size = Vector3.new(hitboxSize,hitboxSize,hitboxSize)
                jug.Character.HumanoidRootPart.CanCollide = false
            end
        end
    else
        for _,jug in pairs(Players:GetPlayers()) do
            if jug~=player and jug.Character and jug.Character:FindFirstChild("HumanoidRootPart") then
                jug.Character.HumanoidRootPart.Size = Vector3.new(2,2,1)
                jug.Character.HumanoidRootPart.CanCollide = true
            end
        end
    end
end)

