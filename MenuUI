RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    local hum = char.Humanoid
    hum.WalkSpeed = velocidad
    hum.JumpPower = salto
    if flying then
        local camDir = camera.CFrame.LookVector
        local moveDir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += camDir end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= camDir end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= camDir:Cross(Vector3.new(0,1,0)).Unit end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camDir:Cross(Vector3.new(0,1,0)).Unit end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir += Vector3.new(0,-1,0) end
        if moveDir.Magnitude > 0 then char.HumanoidRootPart.Velocity = moveDir.Unit * flySpeed else char.HumanoidRootPart.Velocity = Vector3.new(0,0,0) end
    end
end)

task.spawn(function()
    while task.wait(0.05) do
        if not espEnabled then for _,c in espFolder:GetChildren() do c:Destroy() end continue end
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=player and esEnemigo(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character.Humanoid.Health>0 then
                local hrp = p.Character.HumanoidRootPart
                local pos,vis = camera:WorldToViewportPoint(hrp.Position+Vector3.new(0,2,0))
                local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
                local tag = espFolder:FindFirstChild("ESP_"..p.UserId) or Instance.new("TextLabel")
                tag.Name = "ESP_"..p.UserId
                tag.BackgroundTransparency = 1
                tag.Font = Enum.Font.GothamBold
                tag.TextSize = 12
                tag.TextStrokeTransparency = 0
                tag.TextColor3 = espColor
                tag.Parent = espFolder
                if vis then
                    tag.Position = UDim2.new(0,pos.X,0,pos.Y-30)
                    tag.Text = espSettings.Name and p.Name or ""
                    tag.Text ..= espSettings.Health and "\nVida: "..math.floor(p.Character.Humanoid.Health) or ""
                    tag.Text ..= espSettings.Distance and "\nDist: "..dist or ""
                else tag.Text = "" end
            else
                if espFolder:FindFirstChild("ESP_"..p.UserId) then espFolder["ESP_"..p.UserId]:Destroy() end
            end
        end
    end
end)

