local function esLaPistola(item)
    if not item or not item:IsA("Tool") then return false end
    local nom = string.lower(item.Name)
    local prohib = {"cuchillo","knife","sword","fist","combat","punch","phone","wallet"}
    for _,p in ipairs(prohib) do if nom:find(p) then return false end end
    return true
end
local function estaEnLobby()
    local c = player.Character if not c then return true end
    if c:FindFirstChildOfClass("ForceField") then return true end
    if player.Team then local tn = string.lower(player.Team.Name) if tn:find("lobby") or tn:find("spect") or tn:find("dead") then return true end end
    return false
end
local function esEnemigo(p)
    if p==player then return false end
    if not teamCheckEnabled then return true end
    return player.Team ~= p.Team
end

