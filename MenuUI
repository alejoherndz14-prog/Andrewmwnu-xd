-- FUNCIONES AUXILIARES
local function esPistola(herramienta)
    if not herramienta or not herramienta:IsA("Tool") then return false end
    local nom = string.lower(herramienta.Name)
    local prohib = {"cuchillo","knife","sword","fist","combat","phone","wallet"}
    for _,p in ipairs(prohib) do if nom:find(p) then return false end end
    return true
end

local function esEnemigo(objetivo)
    if objetivo == player then return false end
    if not teamCheck then return true end
    if player.Team and objetivo.Team then return player.Team ~= objetivo.Team end
    local eqJug = player:GetAttribute("Team") or player.TeamColor.Name
    local eqObj = objetivo:GetAttribute("Team") or objetivo.TeamColor.Name
    return eqJug ~= eqObj
end

local function estaEnLobby()
    local pj = player.Character
    if not pj then return true end
    if pj:FindFirstChildOfClass("ForceField") then return true end
    if player.Team then
        local nom = string.lower(player.Team.Name)
        if nom:find("lobby") or nom:find("espect") or nom:find("dead") then return true end
    end
    return false
end

